{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InDesign style system",
  "description": "Input for scripts/build_idml.py. Type sizes are in points; page geometry is in millimetres. Unknown keys are ignored by the generator, so you can keep notes (role, source, maps_from, notes, estimated) next to each item.",
  "type": "object",
  "required": ["name", "paragraph_styles"],
  "properties": {
    "name": { "type": "string", "description": "Template name." },
    "source": { "type": "string", "description": "Where the system was extracted from." },
    "document": {
      "type": "object",
      "properties": {
        "page_size": {
          "description": "A3, A4, A5, B5, Letter, Legal, Tabloid, or a custom size.",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["width_mm", "height_mm"],
              "properties": {
                "width_mm": { "type": "number" },
                "height_mm": { "type": "number" }
              }
            }
          ]
        },
        "orientation": { "enum": ["portrait", "landscape"] },
        "facing_pages": { "type": "boolean", "default": false },
        "margins_mm": {
          "description": "One number for all sides, or each side. With facing pages, inside/outside follow the spine; without, inside = left and outside = right.",
          "oneOf": [
            { "type": "number" },
            {
              "type": "object",
              "required": ["top", "bottom", "inside", "outside"],
              "properties": {
                "top": { "type": "number" },
                "bottom": { "type": "number" },
                "inside": { "type": "number" },
                "outside": { "type": "number" }
              }
            }
          ]
        },
        "columns": { "type": "integer", "minimum": 1, "default": 1, "description": "Columns of the page grid (margin guides)." },
        "text_frame_columns": { "type": "integer", "minimum": 1, "description": "Columns of the text frame on page 1 when they differ from the grid, e.g. a 4-column grid with 1-column running text. Defaults to columns." },
        "gutter_mm": { "type": "number", "default": 5 },
        "bleed_mm": { "type": "number", "default": 3 },
        "units": { "enum": ["mm", "cm", "pt", "pica", "in"], "default": "mm" },
        "default_paragraph_style": { "type": "string", "description": "Style applied to the empty text frame on page 1." }
      }
    },
    "colors": {
      "type": "array",
      "description": "Brand swatches. Black, Paper, Registration and None always exist and can be referenced by name.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Swatch name exactly as the brand calls it." },
          "cmyk": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 }, "minItems": 4, "maxItems": 4 },
          "rgb": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
          "hex": { "type": "string", "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
          "spot": { "type": "boolean", "default": false },
          "role": { "type": "string" },
          "estimated": { "type": "boolean" }
        },
        "oneOf": [
          { "required": ["cmyk"] },
          { "required": ["rgb"] },
          { "required": ["hex"] }
        ]
      }
    },
    "paragraph_styles": {
      "type": "array",
      "items": { "$ref": "#/definitions/paragraphStyle" }
    },
    "character_styles": {
      "type": "array",
      "items": { "$ref": "#/definitions/characterStyle" }
    }
  },
  "definitions": {
    "common": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Unique within its kind. No ':' characters." },
        "group": { "type": "string", "description": "Style group (folder). Use '/' for nested groups, e.g. 'Headings/Chapter'." },
        "based_on": { "type": "string", "description": "Name of the parent style of the same kind." },
        "font": { "type": "string", "description": "Font family as InDesign names it, e.g. 'Minion Pro'." },
        "font_style": { "type": "string", "description": "Font style as InDesign names it, e.g. 'Regular', 'Bold', 'Semibold Italic'." },
        "size_pt": { "type": "number" },
        "leading_pt": { "description": "Points, or 'auto'.", "oneOf": [{ "type": "number" }, { "const": "auto" }] },
        "color": { "type": "string", "description": "Swatch name." },
        "tint": { "type": "number", "minimum": 0, "maximum": 100 },
        "tracking": { "type": "integer", "description": "Thousandths of an em." },
        "case": { "enum": ["normal", "uppercase", "small-caps", "caps-to-small-caps"] },
        "underline": { "type": "boolean" },
        "strikethrough": { "type": "boolean" },
        "language": { "type": "string", "description": "Raw InDesign language id, e.g. '$ID/English: USA'. Leave out unless you know the exact id." },
        "estimated": {
          "description": "true, or the list of fields that were estimated rather than measured.",
          "oneOf": [{ "type": "boolean" }, { "type": "array", "items": { "type": "string" } }]
        },
        "notes": { "type": "string" }
      }
    },
    "paragraphStyle": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "properties": {
            "space_before_pt": { "type": "number" },
            "space_after_pt": { "type": "number" },
            "first_line_indent_pt": { "type": "number" },
            "left_indent_pt": { "type": "number" },
            "right_indent_pt": { "type": "number" },
            "align": { "enum": ["left", "center", "right", "justify", "justify-all", "towards-spine", "away-from-spine"] },
            "hyphenate": { "type": "boolean" },
            "keep_with_next": { "type": "integer", "minimum": 0, "description": "Lines to keep with the next paragraph." },
            "keep_lines_together": { "type": "boolean" },
            "start": { "enum": ["anywhere", "next-column", "next-frame", "next-page", "next-odd-page", "next-even-page"] },
            "span_columns": { "type": "boolean", "description": "Paragraph spans all columns (good for headlines in multi-column layouts)." },
            "list": { "enum": ["none", "bullet", "numbered"] },
            "next_style": { "type": "string", "description": "Paragraph style that follows when you press Return." },
            "maps_from": { "type": "array", "items": { "type": "string" }, "description": "Word style names that should become this style on import (used by import_docx.jsx)." },
            "sample_text": { "type": "string", "description": "Text used by --specimen." }
          }
        }
      ]
    },
    "characterStyle": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "properties": {
            "position": { "enum": ["normal", "superscript", "subscript"] }
          }
        }
      ]
    }
  }
}
